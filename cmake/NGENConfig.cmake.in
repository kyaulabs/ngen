@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(enkiTS 1.12 CONFIG)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/NGENCoreTargets.cmake")

if("Renderer" IN_LIST NGEN_FIND_COMPONENTS)
  set(NGEN_Renderer_FOUND FALSE)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/NGENRendererTargets.cmake")
    if(NGEN_FIND_REQUIRED_Renderer)
      find_dependency(SDL3 3.4 CONFIG)
      find_dependency(Vulkan 1.3)
      find_dependency(VulkanMemoryAllocator 3.3 CONFIG)
    else()
      find_package(SDL3 3.4 CONFIG QUIET)
      find_package(Vulkan 1.3 QUIET)
      find_package(VulkanMemoryAllocator 3.3 CONFIG QUIET)
    endif()
    if(SDL3_FOUND AND Vulkan_FOUND AND VulkanMemoryAllocator_FOUND
       AND TARGET SDL3::SDL3 AND TARGET Vulkan::Vulkan AND TARGET GPUOpen::VulkanMemoryAllocator)
      include("${CMAKE_CURRENT_LIST_DIR}/NGENRendererTargets.cmake")
      set(NGEN_Renderer_FOUND TRUE)
    endif()
  elseif(NGEN_FIND_REQUIRED_Renderer)
    set(NGEN_NOT_FOUND_MESSAGE "This SDK prefix has no Renderer component; build with NGEN_BUILD_RENDERER=ON.")
  endif()
endif()
if("Assets" IN_LIST NGEN_FIND_COMPONENTS)
  set(NGEN_Assets_FOUND FALSE)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/NGENAssetsTargets.cmake")
    if(NGEN_FIND_REQUIRED_Assets)
      find_dependency(ZLIB 1.3.2 CONFIG)
    else()
      find_package(ZLIB 1.3.2 CONFIG QUIET)
    endif()
    if(ZLIB_FOUND AND TARGET ZLIB::ZLIB)
      include("${CMAKE_CURRENT_LIST_DIR}/NGENAssetsTargets.cmake")
      set(NGEN_Assets_FOUND TRUE)
    endif()
  elseif(NGEN_FIND_REQUIRED_Assets)
    set(NGEN_NOT_FOUND_MESSAGE "This SDK prefix has no Assets component; build with NGEN_BUILD_ASSETS=ON.")
  endif()
endif()
check_required_components(NGEN)
