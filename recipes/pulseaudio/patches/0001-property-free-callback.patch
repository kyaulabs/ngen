From: NGEN maintainers
Subject: [PATCH] pulse: match property destruction to the hashmap callback type

The native desktop audio regression with Clang UBSan diagnoses a call through
void (*)(void *) to property_free(struct property *). Accept the declared callback
argument and convert inside the function; preserve destruction and direct callers.
This is a project-local change to PulseAudio 17.0, not an upstream release claim.

--- a/src/pulse/proplist.c
+++ b/src/pulse/proplist.c
@@ -54,7 +54,9 @@ int pa_proplist_key_valid(const char *key) {
     return 1;
 }
 
-static void property_free(struct property *prop) {
+/* NGEN: keep the hashmap free callback's declared function-pointer ABI. */
+static void property_free(void *userdata) {
+    struct property *prop = userdata;
     pa_assert(prop);
 
     pa_xfree(prop->key);
@@ -63,7 +65,7 @@ static void property_free(struct property *prop) {
 }
 
 pa_proplist* pa_proplist_new(void) {
-    return MAKE_PROPLIST(pa_hashmap_new_full(pa_idxset_string_hash_func, pa_idxset_string_compare_func, NULL, (pa_free_cb_t) property_free));
+    return MAKE_PROPLIST(pa_hashmap_new_full(pa_idxset_string_hash_func, pa_idxset_string_compare_func, NULL, property_free));
 }
 
 void pa_proplist_free(pa_proplist* p) {
