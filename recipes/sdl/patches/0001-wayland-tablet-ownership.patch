+/* NGEN local repair: retain ignored tablet/pad proxies until removal or shutdown. */
+typedef enum {
+    WAYLAND_TABLET_OBJECT,
+    WAYLAND_PAD_OBJECT,
+    WAYLAND_PAD_GROUP_OBJECT
+} Wayland_TabletObjectType;
+
+typedef struct Wayland_TabletObject {
+    void *proxy;
+    Wayland_TabletObjectType type;
+    struct wl_list link;
+    struct wl_list children;
+} Wayland_TabletObject;
+
+static Wayland_TabletObject *Wayland_TabletObjectCreate(void *proxy, Wayland_TabletObjectType type, struct wl_list *list)
+{
+    Wayland_TabletObject *object = SDL_calloc(1, sizeof(*object));
+    if (!object) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    object->proxy = proxy;
+    object->type = type;
+    WAYLAND_wl_list_init(&object->children);
+    WAYLAND_wl_list_insert(list, &object->link);
+    return object;
+}
+
+static void Wayland_TabletObjectDestroy(Wayland_TabletObject *object)
+{
+    Wayland_TabletObject *child, *temp;
+    wl_list_for_each_safe (child, temp, &object->children, link) {
+        Wayland_TabletObjectDestroy(child);
+    }
+    switch (object->type) {
+    case WAYLAND_TABLET_OBJECT:
+        zwp_tablet_v2_destroy(object->proxy);
+        break;
+    case WAYLAND_PAD_OBJECT:
+        zwp_tablet_pad_v2_destroy(object->proxy);
+        break;
+    case WAYLAND_PAD_GROUP_OBJECT:
+        zwp_tablet_pad_group_v2_destroy(object->proxy);
+        break;
+    }
+    WAYLAND_wl_list_remove(&object->link);
+    SDL_free(object);
+}
+
+static void tablet_handle_name(void *data, struct zwp_tablet_v2 *tablet, const char *name) {}
+static void tablet_handle_id(void *data, struct zwp_tablet_v2 *tablet, uint32_t vid, uint32_t pid) {}
+static void tablet_handle_path(void *data, struct zwp_tablet_v2 *tablet, const char *path) {}
+static void tablet_handle_done(void *data, struct zwp_tablet_v2 *tablet)
+{
+    if (!data) {
+        zwp_tablet_v2_destroy(tablet);
+    }
+}
+static void tablet_handle_removed(void *data, struct zwp_tablet_v2 *tablet)
+{
+    if (data) {
+        Wayland_TabletObjectDestroy(data);
+    } else {
+        zwp_tablet_v2_destroy(tablet);
+    }
+}
+static const struct zwp_tablet_v2_listener tablet_listener = {
+    tablet_handle_name, tablet_handle_id, tablet_handle_path,
+    tablet_handle_done, tablet_handle_removed
+};
