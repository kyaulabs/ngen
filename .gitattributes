# Keep the supplied PDF guide binary; whitespace changes would corrupt its offsets.
brand/guide/ngen-brand-guide.pdf binary

# Blank unified-diff context lines (including final hunk lines) are patch syntax.
recipes/sdl/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof

# Preserve these original tool legal notices byte-for-byte.
docs/evidence/M2/cooked-scene/licenses/ktx/Apache-2.0.txt whitespace=-blank-at-eol
docs/evidence/M2/cooked-scene/licenses/ktx/CC-BY-4.0.txt whitespace=-blank-at-eof
docs/evidence/M2/cooked-scene/licenses/ktx/LICENSE.md whitespace=-blank-at-eol

# Preserve these upstream legal notices byte-for-byte, including their line endings.
docs/evidence/M2/shader-interface/licenses/slangc/third-party-notices/miniz-LICENSE -text whitespace=cr-at-eol
docs/evidence/M2/shader-interface/licenses/spirv-headers/LICENSE whitespace=-blank-at-eof
docs/evidence/M2/shader-interface/licenses/spirv-headers/LICENSES/MIT.txt whitespace=-blank-at-eol

# Preserve byte-exact Windows tool manifests/reflections with native CRLF endings.
docs/evidence/M2/windows-scene-debug/*/*.json -text whitespace=cr-at-eol
docs/evidence/M2/windows-frigate-verified/*/*.json -text whitespace=cr-at-eol
docs/evidence/M2/windows-workload-verified/*/*.json -text whitespace=cr-at-eol

docs/evidence/M2/closure/windows-b2/*/*.json -text whitespace=cr-at-eol
docs/evidence/M2/closure/windows-b2/*/*.csv -text whitespace=cr-at-eol
docs/evidence/M2/closure/windows-final/*/*.json -text whitespace=cr-at-eol
docs/evidence/M2/closure/windows-final/*/*.csv -text whitespace=cr-at-eol
