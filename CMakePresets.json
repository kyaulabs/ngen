    {"name":"asan","configurePreset":"asan","jobs":2},
    {"name":"tsan","configurePreset":"tsan","jobs":2},
    {"name":"renderer-debug","configurePreset":"renderer-debug","jobs":2},
    {"name":"renderer-release","configurePreset":"renderer-release","jobs":2},
    {"name":"renderer-asan","configurePreset":"renderer-asan","jobs":2}
  ],
  "testPresets": [
