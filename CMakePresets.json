    {"name":"renderer-debug","configurePreset":"renderer-debug","output":{"outputOnFailure":true},"execution":{"noTestsAction":"error"}},
    {"name":"renderer-release","configurePreset":"renderer-release","output":{"outputOnFailure":true},"execution":{"noTestsAction":"error"}},
    {"name":"renderer-asan","configurePreset":"renderer-asan","output":{"outputOnFailure":true},"execution":{"noTestsAction":"error"},"environment":{"ASAN_OPTIONS":"detect_leaks=1:halt_on_error=1","UBSAN_OPTIONS":"halt_on_error=1:print_stacktrace=1"}}
