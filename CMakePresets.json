{
  "version": 6,
  "configurePresets": [
    {"name":"base","hidden":true,"generator":"Ninja","binaryDir":"${sourceDir}/build/${presetName}","cacheVariables":{"CMAKE_TOOLCHAIN_FILE":"${sourceDir}/build/${presetName}/conan_toolchain.cmake","CMAKE_EXPORT_COMPILE_COMMANDS":"ON","BUILD_TESTING":"ON"}},
