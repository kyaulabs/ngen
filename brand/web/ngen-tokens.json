  "components": {
    "dark": {
      "bg-0": "#04060C",
      "panel": "color-mix(in srgb, #0A101D 66%, transparent)",
      "panel-2": "color-mix(in srgb, #10182A 55%, transparent)",
      "line": "color-mix(in srgb, #7D9BD2 14%, transparent)",
      "line-strong": "color-mix(in srgb, #7D9BD2 30%, transparent)"
    },
    "light": {
      "bg-0": "#EDF0F8",
      "panel": "color-mix(in srgb, #FFFFFF 78%, transparent)",
      "panel-2": "color-mix(in srgb, #F4F7FD 85%, transparent)",
      "line": "color-mix(in srgb, #102A54 12%, transparent)",
      "line-strong": "color-mix(in srgb, #102A54 26%, transparent)"
    }
  },
  "typography": {
    "sans": "'Neo Sans Pro', system-ui, sans-serif",
    "mono": "'Operator Mono', ui-monospace, 'Cascadia Code', monospace"
  }
