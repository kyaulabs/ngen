include(linux-clang)
[conf]
user.ngen:sanitizer=thread
tools.info.package_id:confs=["user.ngen:sanitizer"]
tools.build:cflags=["-fsanitize=thread", "-fno-sanitize-recover=all", "-fno-omit-frame-pointer"]
tools.build:cxxflags=["-fsanitize=thread", "-fno-sanitize-recover=all", "-fno-omit-frame-pointer"]
tools.build:exelinkflags=["-fsanitize=thread"]
tools.build:sharedlinkflags=["-fsanitize=thread"]
